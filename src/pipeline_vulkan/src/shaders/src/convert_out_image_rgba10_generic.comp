// Generic Vulkan output conversion shader for 4:2:2/4:4:4
// R10G10B10A2 (VK_FORMAT_A2B10G10R10_UNORM_PACK32) VkImage destinations.

#version 450

#include "specialization_ids.h"

layout(local_size_x_id = SPECID_LOCAL_SIZE_X,
       local_size_y_id = SPECID_LOCAL_SIZE_Y,
       local_size_z_id = SPECID_LOCAL_SIZE_Z) in;

layout(rgb10_a2, set = 0, binding = 1) uniform restrict writeonly image2D dstImage;

#include "convert_out_image_common.glsl"

void main()
{
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);

    if (x >= width || y >= height) {
        return;
    }

    const int cx = x >> chromaWidthShift;
    const int cy = y >> chromaHeightShift;
    const float yf = internalToUnorm(loadInternalValue(x, y, containerStrideY, containerOffsetY,
                                                        containerStrideTemporalY, containerOffsetTemporalY),
                                     5, 1023);
    const vec2 uv = loadChroma(cx, cy, 5, 1023);
    imageStore(dstImage, ivec2(x, y), vec4(yuvToRgb601(yf, uv.x, uv.y), 1.0));
}
