// Internal planar 4:2:0 to P010 buffer conversion, 2x2 luma samples per invocation.

#version 450

#include "specialization_ids.h"

layout(local_size_x_id = SPECID_LOCAL_SIZE_X, local_size_y_id = SPECID_LOCAL_SIZE_Y,
       local_size_z_id = SPECID_LOCAL_SIZE_Z) in;

#include "convert_out_common.glsl"

void main()
{
    const int blockX = int(gl_GlobalInvocationID.x);
    const int blockY = int(gl_GlobalInvocationID.y);
    const int y = blockY << 1;
    if ((blockX << 1) >= width || y >= height) {
        return;
    }

    uvec2 outputY0;
    uvec2 outputY1;
    if (sharpen) {
        const int x = blockX << 1;
        outputY0 = uvec2(sharpenPixel(x, y, 5), sharpenPixel(x + 1, y, 5)) << 6;
        outputY1 = uvec2(sharpenPixel(x, y + 1, 5), sharpenPixel(x + 1, y + 1, 5)) << 6;
    } else {
        const ivec2 y0 = loadInternalPair(blockX, y, containerStrideIn, containerOffsetIn,
                                          containerStrideTemporal0, containerOffsetTemporal0);
        const ivec2 y1 = loadInternalPair(blockX, y + 1, containerStrideIn, containerOffsetIn,
                                          containerStrideTemporal0, containerOffsetTemporal0);
        outputY0 = fromInternalTo16bit(y0, 5) << 6;
        outputY1 = fromInternalTo16bit(y1, 5) << 6;
    }
    dst.samples[uint(containerOffsetOut + y * containerStrideOut + blockX)] = pack16bit(outputY0);
    dst.samples[uint(containerOffsetOut + (y + 1) * containerStrideOut + blockX)] = pack16bit(outputY1);

    const int u = loadInternalValue(blockX, blockY, containerStrideU, containerOffsetU,
                                    containerStrideTemporal1, containerOffsetTemporal1);
    const int v = loadInternalValue(blockX, blockY, containerStrideV, containerOffsetV,
                                    containerStrideTemporal2, containerOffsetTemporal2);
    dst.samples[uint(containerOffsetUVOut + blockY * containerStrideUVOut + blockX)] =
        pack16bit(fromInternalTo16bit(ivec2(u, v), 5) << 6);
}
