// Vulkan output conversion shader for P010 AHardwareBuffer VkImage destinations.

#version 450

#include "specialization_ids.h"

layout(local_size_x_id = SPECID_LOCAL_SIZE_X,
       local_size_y_id = SPECID_LOCAL_SIZE_Y,
       local_size_z_id = SPECID_LOCAL_SIZE_Z) in;

layout(r16,  set = 0, binding = 1) uniform restrict writeonly image2D dstY;
layout(rg16, set = 0, binding = 2) uniform restrict writeonly image2D dstUV;

#include "convert_out_image_common.glsl"

void main()
{
    const int cx = int(gl_GlobalInvocationID.x);
    const int cy = int(gl_GlobalInvocationID.y);
    const int x = cx << 1;
    const int y = cy << 1;

    if (x >= width || y >= height) {
        return;
    }

    const ivec2 y0 = loadInternalPair(cx, y, containerStrideY, containerOffsetY,
                                      containerStrideTemporalY, containerOffsetTemporalY);
    const ivec2 y1 = loadInternalPair(cx, y + 1, containerStrideY, containerOffsetY,
                                      containerStrideTemporalY, containerOffsetTemporalY);
    imageStore(dstY, ivec2(x, y), vec4(internalToUnorm(y0.x, 5, 1023), 0.0, 0.0, 1.0));
    imageStore(dstY, ivec2(x + 1, y), vec4(internalToUnorm(y0.y, 5, 1023), 0.0, 0.0, 1.0));
    imageStore(dstY, ivec2(x, y + 1), vec4(internalToUnorm(y1.x, 5, 1023), 0.0, 0.0, 1.0));
    imageStore(dstY, ivec2(x + 1, y + 1), vec4(internalToUnorm(y1.y, 5, 1023), 0.0, 0.0, 1.0));

    const float u = internalToUnorm(loadInternalValue(cx, cy, containerStrideU, containerOffsetU,
                                                       containerStrideTemporalU, containerOffsetTemporalU),
                                    5, 1023);
    const float v = internalToUnorm(loadInternalValue(cx, cy, containerStrideV, containerOffsetV,
                                                       containerStrideTemporalV, containerOffsetTemporalV),
                                    5, 1023);
    imageStore(dstUV, ivec2(cx, cy), vec4(u, v, 0.0, 1.0));
}
