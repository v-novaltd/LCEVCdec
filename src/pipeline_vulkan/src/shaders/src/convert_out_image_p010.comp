// Vulkan output conversion shader for P010 AHardwareBuffer VkImage destinations.

#version 450

#include "specialization_ids.h"

layout(local_size_x_id = SPECID_LOCAL_SIZE_X,
       local_size_y_id = SPECID_LOCAL_SIZE_Y,
       local_size_z_id = SPECID_LOCAL_SIZE_Z) in;

layout(r16,  set = 0, binding = 1) uniform restrict writeonly image2D dstY;
layout(rg16, set = 0, binding = 2) uniform restrict writeonly image2D dstUV;

#include "convert_out_image_common.glsl"

void main()
{
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);

    if (x >= width || y >= height) {
        return;
    }

    const float yf = internalToUnorm(loadInternalValue(x, y, containerStrideY, containerOffsetY), 5, 1023);
    imageStore(dstY, ivec2(x, y), vec4(yf, 0.0, 0.0, 1.0));

    const int chromaMaskX = (1 << chromaWidthShift) - 1;
    const int chromaMaskY = (1 << chromaHeightShift) - 1;
    if ((x & chromaMaskX) == 0 && (y & chromaMaskY) == 0) {
        const int cx = x >> chromaWidthShift;
        const int cy = y >> chromaHeightShift;
        const float u = internalToUnorm(loadInternalValue(cx, cy, containerStrideU, containerOffsetU), 5, 1023);
        const float v = internalToUnorm(loadInternalValue(cx, cy, containerStrideV, containerOffsetV), 5, 1023);
        imageStore(dstUV, ivec2(cx, cy), vec4(u, v, 0.0, 1.0));
    }
}
