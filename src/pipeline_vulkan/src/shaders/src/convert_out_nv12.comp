// Internal planar 4:2:0 to NV12/NV21 buffer conversion, 4x2 luma samples per invocation.
// The host exchanges the U/V source and temporal metadata for NV21.

#version 450

#include "specialization_ids.h"

layout(local_size_x_id = SPECID_LOCAL_SIZE_X,
       local_size_y_id = SPECID_LOCAL_SIZE_Y,
       local_size_z_id = SPECID_LOCAL_SIZE_Z) in;

#include "convert_out_common.glsl"

void main()
{
    const int blockX = int(gl_GlobalInvocationID.x);
    const int blockY = int(gl_GlobalInvocationID.y);
    const int x = blockX << 2;
    const int y = blockY << 1;
    if (x >= width || y >= height) {
        return;
    }

    uvec4 outputY0;
    uvec4 outputY1;
    if (sharpen) {
        outputY0 = uvec4(sharpenPixel(x, y, 7), sharpenPixel(x + 1, y, 7),
                         sharpenPixel(x + 2, y, 7), sharpenPixel(x + 3, y, 7));
        outputY1 = uvec4(sharpenPixel(x, y + 1, 7), sharpenPixel(x + 1, y + 1, 7),
                         sharpenPixel(x + 2, y + 1, 7), sharpenPixel(x + 3, y + 1, 7));
    } else {
        const ivec2 y00 = loadInternalPair(blockX << 1, y, containerStrideIn, containerOffsetIn,
                                           containerStrideTemporal0, containerOffsetTemporal0);
        const ivec2 y01 = loadInternalPair((blockX << 1) + 1, y, containerStrideIn,
                                           containerOffsetIn, containerStrideTemporal0,
                                           containerOffsetTemporal0);
        const ivec2 y10 = loadInternalPair(blockX << 1, y + 1, containerStrideIn,
                                           containerOffsetIn, containerStrideTemporal0,
                                           containerOffsetTemporal0);
        const ivec2 y11 = loadInternalPair((blockX << 1) + 1, y + 1, containerStrideIn,
                                           containerOffsetIn, containerStrideTemporal0,
                                           containerOffsetTemporal0);
        outputY0 = fromInternalTo8bit(ivec4(y00, y01));
        outputY1 = fromInternalTo8bit(ivec4(y10, y11));
    }
    dst.samples[uint(containerOffsetOut + y * containerStrideOut + blockX)] = pack8bit(outputY0);
    dst.samples[uint(containerOffsetOut + (y + 1) * containerStrideOut + blockX)] = pack8bit(outputY1);

    const ivec2 u = loadInternalPair(blockX, blockY, containerStrideU, containerOffsetU,
                                     containerStrideTemporal1, containerOffsetTemporal1);
    const ivec2 v = loadInternalPair(blockX, blockY, containerStrideV, containerOffsetV,
                                     containerStrideTemporal2, containerOffsetTemporal2);
    const uvec4 uv = fromInternalTo8bit(ivec4(u.x, v.x, u.y, v.y));
    dst.samples[uint(containerOffsetUVOut + blockY * containerStrideUVOut + blockX)] =
        pack8bit(uv);
}
